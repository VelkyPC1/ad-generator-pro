# --- Bezpečnostné nastavenia (2026-09-19) ---
# Blokuje pre/post-install skripty = hlavný vektor npm supply-chain útokov.
# Overené 2026-09-19: žiadny @remotion/* balíček install hooky nepotrebuje.
ignore-scripts=true

# Presné verzie, žiadny tichý upgrade pri install.
save-exact=true

# Hlási zraniteľnosti pri install.
audit-level=moderate
fund=false
